{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@ciphera/types": ["../../packages/types/dist/index.d.ts"],
      "@ciphera/validation": ["../../packages/validation/dist/index.d.ts"],
      "@ciphera/contracts": ["../../packages/contracts/dist/index.d.ts"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "types": ["node"]
  },
  "include": ["src"]
}
