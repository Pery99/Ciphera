DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ciphera?schema=public"
NODE_ENV="development"
PORT="3000"

# Production: use unique random secrets, each at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="replace-with-a-long-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-refresh-secret"

CORS_ORIGIN="http://localhost:5173"
APP_WEB_URL="http://localhost:5173"

# Cookie policy for refresh tokens (httpOnly). Dev uses lax + vite proxy.
# Railway + separate web host (Vercel, Netlify, Railway static): none + secure.
# COOKIE_SAME_SITE="none"
# COOKIE_SECURE="true"

REDIS_URL="redis://localhost:6379"
QUEUE_PREFIX="ciphera"

# --- Railway (API service) ---
# 1. New project -> add PostgreSQL + Redis plugins.
# 2. Add GitHub repo service; root directory: / (repo root). Uses railpack.json + railway.toml at repo root.
# 3. Variables (reference plugin URLs when linked):
#    DATABASE_URL=${{Postgres.DATABASE_URL}}
#    REDIS_URL=${{Redis.REDIS_URL}}
#    NODE_ENV=production
#    CORS_ORIGIN=https://your-web-app-url
#    APP_WEB_URL=https://your-web-app-url
#    COOKIE_SAME_SITE=none
#    COOKIE_SECURE=true
# 4. Service -> Settings -> Networking -> Generate Domain.
# 5. Web build env (host web on Vercel/Netlify/Railway static):
#    VITE_API_URL=https://your-api.up.railway.app/api
#    VITE_SOCKET_URL=https://your-api.up.railway.app

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@ciphera.app"
